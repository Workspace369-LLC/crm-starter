# Personal access token from Workspace369: Settings → AI → AI connections.
# Server-side only. Never prefix it with NEXT_PUBLIC_. Copy this file to .env.local.
W369_TOKEN=
# Password for opening the app (HTTP Basic, any user name). Required in
# production: without it the deployed app serves nothing. Optional locally.
# APP_PASSWORD=
# Optional. Defaults to https://mcp.workspace369.com/mcp/crm (the core CRM
# tools); https://mcp.workspace369.com/mcp is the full set.
# W369_MCP_URL=https://mcp.workspace369.com/mcp/crm
# Mock mode (no account): run `npm run mock`, then set
# W369_TOKEN=mock-token
# W369_MCP_URL=http://localhost:4010/mcp
