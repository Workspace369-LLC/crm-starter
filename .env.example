# Personal access token from Workspace369: Settings > AI connections.
# Server-side only. Never prefix it with NEXT_PUBLIC_. Copy this file to .env.local.
W369_TOKEN=
# The core CRM tools (the default). https://mcp.workspace369.com/mcp is the full set of tools.
W369_MCP_URL=https://mcp.workspace369.com/mcp/crm
# Mock mode (no account): run `npm run mock`, then set
# W369_TOKEN=mock-token
# W369_MCP_URL=http://localhost:4010/mcp
